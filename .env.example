# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=join.api.sascha-gerspach.de localhost 127.0.0.1
CORS_ALLOWED_ORIGINS=https://join.sascha-gerspach.de
CSRF_TRUSTED_ORIGINS=https://join.sascha-gerspach.de
FRONTEND_URL=https://join.sascha-gerspach.de

# Cookies (default: Secure+SameSite=None when DJANGO_DEBUG=false, Lax/not-secure otherwise)
# SESSION_COOKIE_SECURE=true
# CSRF_COOKIE_SECURE=true
# SESSION_COOKIE_SAMESITE=None
# CSRF_COOKIE_SAMESITE=None

# Cookie domain: if frontend and backend live on subdomains of the same parent domain,
# set the parent domain with a leading dot so frontend JS can read the CSRF cookie.
COOKIE_DOMAIN=.sascha-gerspach.de

# PostgreSQL
POSTGRES_DB=join
POSTGRES_USER=join
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db

# Email (optional — defaults to console output if not set)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=noreply@example.com
EMAIL_HOST_PASSWORD=smtp-password
DEFAULT_FROM_EMAIL=noreply@example.com

# Backend domain (must point to the backend server via a DNS A record).
# Traefik on the host handles routing + SSL.
DOMAIN=join.api.sascha-gerspach.de

# Staging (only for docker-compose.staging.yml)
# STAGING_DOMAIN=staging.api.sascha-gerspach.de

# Sentry (optional)
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Replicas (optional, default: 1)
# BACKEND_REPLICAS=1
